[Unit]
Description=Automatic keyboard backlight from ambient light
Documentation=man:kbd-autolight(1)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/kbd-autolight run
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
