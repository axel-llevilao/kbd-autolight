msgid "Automatic keyboard brightness"
msgstr "בהירות מקלדת אוטומטית"

msgid "Adjusts the keyboard backlight to the ambient light"
msgstr "מתאים את תאורת המקלדת לאור הסביבה"

msgid "Ambient light: %1 lux"
msgstr "אור סביבה: %1 לוקס"

msgid "Keyboard backlight: level %1 of %2"
msgstr "תאורה אחורית: רמה %1 מתוך %2"

msgid "Paused after a manual change (%1 min left)"
msgstr "מושהה לאחר שינוי ידני (נותרו %1 דק׳)"

msgid "Resume now"
msgstr "להמשיך עכשיו"

msgid "Active"
msgstr "פעיל"

msgid "Inactive"
msgstr "לא פעיל"

msgid "Light sensor not available"
msgstr "חיישן האור אינו זמין"
