msgid "Automatic keyboard brightness"
msgstr "Автоматическая яркость клавиатуры"

msgid "Adjusts the keyboard backlight to the ambient light"
msgstr "Настраивает подсветку клавиатуры по окружающему освещению"

msgid "Ambient light: %1 lux"
msgstr "Окружающее освещение: %1 лк"

msgid "Keyboard backlight: level %1 of %2"
msgstr "Подсветка: уровень %1 из %2"

msgid "Paused after a manual change (%1 min left)"
msgstr "Приостановлено после ручного изменения (осталось %1 мин.)"

msgid "Resume now"
msgstr "Возобновить"

msgid "Active"
msgstr "Включено"

msgid "Inactive"
msgstr "Выключено"

msgid "Light sensor not available"
msgstr "Датчик освещённости недоступен"
