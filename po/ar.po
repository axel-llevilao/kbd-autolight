msgid "Automatic keyboard brightness"
msgstr "السطوع التلقائي للوحة المفاتيح"

msgid "Adjusts the keyboard backlight to the ambient light"
msgstr "يضبط الإضاءة الخلفية للوحة المفاتيح حسب الإضاءة المحيطة"

msgid "Ambient light: %1 lux"
msgstr "الإضاءة المحيطة: %1 لوكس"

msgid "Keyboard backlight: level %1 of %2"
msgstr "الإضاءة الخلفية: المستوى %1 من %2"

msgid "Paused after a manual change (%1 min left)"
msgstr "متوقف مؤقتًا بعد تغيير يدوي (متبقٍ %1 د)"

msgid "Resume now"
msgstr "استئناف الآن"

msgid "Active"
msgstr "مفعّل"

msgid "Inactive"
msgstr "معطّل"

msgid "Light sensor not available"
msgstr "مستشعر الضوء غير متاح"
