msgid "Automatic keyboard brightness"
msgstr "Automatický jas klávesnice"

msgid "Adjusts the keyboard backlight to the ambient light"
msgstr "Přizpůsobuje podsvícení klávesnice okolnímu světlu"

msgid "Ambient light: %1 lux"
msgstr "Okolní světlo: %1 lx"

msgid "Keyboard backlight: level %1 of %2"
msgstr "Podsvícení: úroveň %1 z %2"

msgid "Paused after a manual change (%1 min left)"
msgstr "Pozastaveno po ruční změně (zbývá %1 min)"

msgid "Resume now"
msgstr "Obnovit nyní"

msgid "Active"
msgstr "Aktivní"

msgid "Inactive"
msgstr "Neaktivní"

msgid "Light sensor not available"
msgstr "Světelný senzor není dostupný"
