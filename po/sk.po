msgid "Automatic keyboard brightness"
msgstr "Automatický jas klávesnice"

msgid "Adjusts the keyboard backlight to the ambient light"
msgstr "Prispôsobuje podsvietenie klávesnice okolitému svetlu"

msgid "Ambient light: %1 lux"
msgstr "Okolité svetlo: %1 lx"

msgid "Keyboard backlight: level %1 of %2"
msgstr "Podsvietenie: úroveň %1 z %2"

msgid "Paused after a manual change (%1 min left)"
msgstr "Pozastavené po ručnej zmene (zostáva %1 min)"

msgid "Resume now"
msgstr "Obnoviť teraz"

msgid "Active"
msgstr "Aktívne"

msgid "Inactive"
msgstr "Neaktívne"

msgid "Light sensor not available"
msgstr "Svetelný senzor nie je dostupný"
