msgid "Automatic keyboard brightness"
msgstr "Luminosità automatica della tastiera"

msgid "Adjusts the keyboard backlight to the ambient light"
msgstr "Regola la retroilluminazione della tastiera in base alla luce ambientale"

msgid "Ambient light: %1 lux"
msgstr "Luce ambientale: %1 lux"

msgid "Keyboard backlight: level %1 of %2"
msgstr "Retroilluminazione: livello %1 di %2"

msgid "Paused after a manual change (%1 min left)"
msgstr "In pausa dopo una modifica manuale (mancano %1 min)"

msgid "Resume now"
msgstr "Riprendi ora"

msgid "Active"
msgstr "Attivo"

msgid "Inactive"
msgstr "Inattivo"

msgid "Light sensor not available"
msgstr "Sensore di luce non disponibile"
