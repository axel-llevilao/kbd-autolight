msgid "Automatic keyboard brightness"
msgstr "Näppäimistön automaattinen kirkkaus"

msgid "Adjusts the keyboard backlight to the ambient light"
msgstr "Säätää näppäimistön taustavaloa ympäristön valon mukaan"

msgid "Ambient light: %1 lux"
msgstr "Ympäristön valo: %1 lx"

msgid "Keyboard backlight: level %1 of %2"
msgstr "Taustavalo: taso %1/%2"

msgid "Paused after a manual change (%1 min left)"
msgstr "Keskeytetty manuaalisen muutoksen jälkeen (%1 min jäljellä)"

msgid "Resume now"
msgstr "Jatka nyt"

msgid "Active"
msgstr "Käytössä"

msgid "Inactive"
msgstr "Ei käytössä"

msgid "Light sensor not available"
msgstr "Valoanturi ei ole käytettävissä"
