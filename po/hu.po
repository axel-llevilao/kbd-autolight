msgid "Automatic keyboard brightness"
msgstr "Automatikus billentyűzet-fényerő"

msgid "Adjusts the keyboard backlight to the ambient light"
msgstr "A billentyűzet háttérvilágítását a környezeti fényhez igazítja"

msgid "Ambient light: %1 lux"
msgstr "Környezeti fény: %1 lux"

msgid "Keyboard backlight: level %1 of %2"
msgstr "Háttérvilágítás: %1/%2. szint"

msgid "Paused after a manual change (%1 min left)"
msgstr "Szüneteltetve kézi módosítás után (még %1 perc)"

msgid "Resume now"
msgstr "Folytatás most"

msgid "Active"
msgstr "Aktív"

msgid "Inactive"
msgstr "Inaktív"

msgid "Light sensor not available"
msgstr "A fényérzékelő nem érhető el"
