msgid "Automatic keyboard brightness"
msgstr "Automatyczna jasność klawiatury"

msgid "Adjusts the keyboard backlight to the ambient light"
msgstr "Dostosowuje podświetlenie klawiatury do oświetlenia otoczenia"

msgid "Ambient light: %1 lux"
msgstr "Oświetlenie otoczenia: %1 lx"

msgid "Keyboard backlight: level %1 of %2"
msgstr "Podświetlenie: poziom %1 z %2"

msgid "Paused after a manual change (%1 min left)"
msgstr "Wstrzymano po ręcznej zmianie (pozostało %1 min)"

msgid "Resume now"
msgstr "Wznów teraz"

msgid "Active"
msgstr "Aktywne"

msgid "Inactive"
msgstr "Nieaktywne"

msgid "Light sensor not available"
msgstr "Czujnik światła jest niedostępny"
