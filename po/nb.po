msgid "Automatic keyboard brightness"
msgstr "Automatisk lysstyrke for tastaturet"

msgid "Adjusts the keyboard backlight to the ambient light"
msgstr "Tilpasser tastaturets bakgrunnsbelysning etter omgivelseslyset"

msgid "Ambient light: %1 lux"
msgstr "Omgivelseslys: %1 lux"

msgid "Keyboard backlight: level %1 of %2"
msgstr "Bakgrunnsbelysning: nivå %1 av %2"

msgid "Paused after a manual change (%1 min left)"
msgstr "Satt på pause etter en manuell endring (%1 min igjen)"

msgid "Resume now"
msgstr "Fortsett nå"

msgid "Active"
msgstr "Aktiv"

msgid "Inactive"
msgstr "Inaktiv"

msgid "Light sensor not available"
msgstr "Lyssensoren er ikke tilgjengelig"
