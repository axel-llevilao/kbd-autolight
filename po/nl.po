msgid "Automatic keyboard brightness"
msgstr "Automatische toetsenbordhelderheid"

msgid "Adjusts the keyboard backlight to the ambient light"
msgstr "Past de toetsenbordverlichting aan het omgevingslicht aan"

msgid "Ambient light: %1 lux"
msgstr "Omgevingslicht: %1 lux"

msgid "Keyboard backlight: level %1 of %2"
msgstr "Toetsenbordverlichting: niveau %1 van %2"

msgid "Paused after a manual change (%1 min left)"
msgstr "Gepauzeerd na een handmatige wijziging (nog %1 min)"

msgid "Resume now"
msgstr "Nu hervatten"

msgid "Active"
msgstr "Actief"

msgid "Inactive"
msgstr "Inactief"

msgid "Light sensor not available"
msgstr "Lichtsensor niet beschikbaar"
