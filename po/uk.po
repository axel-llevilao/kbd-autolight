msgid "Automatic keyboard brightness"
msgstr "Автоматична яскравість клавіатури"

msgid "Adjusts the keyboard backlight to the ambient light"
msgstr "Налаштовує підсвічування клавіатури відповідно до навколишнього освітлення"

msgid "Ambient light: %1 lux"
msgstr "Навколишнє освітлення: %1 лк"

msgid "Keyboard backlight: level %1 of %2"
msgstr "Підсвічування: рівень %1 з %2"

msgid "Paused after a manual change (%1 min left)"
msgstr "Призупинено після ручної зміни (залишилося %1 хв)"

msgid "Resume now"
msgstr "Відновити"

msgid "Active"
msgstr "Увімкнено"

msgid "Inactive"
msgstr "Вимкнено"

msgid "Light sensor not available"
msgstr "Датчик освітлення недоступний"
