msgid "Ambient light: %1 lux"
msgstr "Ortam ışığı: %1 lüks"

msgid "Keyboard backlight: level %1 of %2"
msgstr "Arka ışık: seviye %1/%2"

msgid "Paused after a manual change (%1 min left)"
msgstr "Elle yapılan değişiklikten sonra duraklatıldı (%1 dk kaldı)"

msgid "Resume now"
msgstr "Şimdi sürdür"

msgid "Active"
msgstr "Etkin"

msgid "Inactive"
msgstr "Devre dışı"

msgid "Light sensor not available"
msgstr "Işık sensörü kullanılamıyor"
