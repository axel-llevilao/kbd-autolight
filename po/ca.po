msgid "Automatic keyboard brightness"
msgstr "Ajust automàtic de la brillantor del teclat"

msgid "Adjusts the keyboard backlight to the ambient light"
msgstr "Ajusta la retroil·luminació del teclat segons la llum ambiental"

msgid "Ambient light: %1 lux"
msgstr "Llum ambiental: %1 lux"

msgid "Keyboard backlight: level %1 of %2"
msgstr "Retroil·luminació: nivell %1 de %2"

msgid "Paused after a manual change (%1 min left)"
msgstr "En pausa després d'un canvi manual (queden %1 min)"

msgid "Resume now"
msgstr "Reprèn ara"

msgid "Active"
msgstr "Actiu"

msgid "Inactive"
msgstr "Inactiu"

msgid "Light sensor not available"
msgstr "El sensor de llum no està disponible"
