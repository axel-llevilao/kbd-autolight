msgid "Automatic keyboard brightness"
msgstr "Tự động điều chỉnh độ sáng bàn phím"

msgid "Adjusts the keyboard backlight to the ambient light"
msgstr "Điều chỉnh đèn nền bàn phím theo ánh sáng môi trường"

msgid "Ambient light: %1 lux"
msgstr "Ánh sáng môi trường: %1 lux"

msgid "Keyboard backlight: level %1 of %2"
msgstr "Đèn nền: mức %1 trên %2"

msgid "Paused after a manual change (%1 min left)"
msgstr "Tạm dừng sau khi thay đổi thủ công (còn %1 phút)"

msgid "Resume now"
msgstr "Tiếp tục ngay"

msgid "Active"
msgstr "Đang bật"

msgid "Inactive"
msgstr "Đang tắt"

msgid "Light sensor not available"
msgstr "Không có cảm biến ánh sáng"
