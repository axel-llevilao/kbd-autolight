msgid "Automatic keyboard brightness"
msgstr "Axuste automático do brillo do teclado"

msgid "Adjusts the keyboard backlight to the ambient light"
msgstr "Axusta a retroiluminación do teclado segundo a luz ambiente"

msgid "Ambient light: %1 lux"
msgstr "Luz ambiente: %1 lux"

msgid "Keyboard backlight: level %1 of %2"
msgstr "Retroiluminación: nivel %1 de %2"

msgid "Paused after a manual change (%1 min left)"
msgstr "En pausa tras un cambio manual (quedan %1 min)"

msgid "Resume now"
msgstr "Retomar agora"

msgid "Active"
msgstr "Activo"

msgid "Inactive"
msgstr "Inactivo"

msgid "Light sensor not available"
msgstr "O sensor de luz non está dispoñíbel"
