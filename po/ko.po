msgid "Paused after a manual change (%1 min left)"
msgstr "수동 변경으로 일시 중지됨 (%1분 남음)"

msgid "Resume now"
msgstr "지금 다시 시작"

msgid "Active"
msgstr "활성"

msgid "Inactive"
msgstr "비활성"

msgid "Light sensor not available"
msgstr "조도 센서를 사용할 수 없음"
