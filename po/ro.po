msgid "Automatic keyboard brightness"
msgstr "Luminozitate automată a tastaturii"

msgid "Adjusts the keyboard backlight to the ambient light"
msgstr "Ajustează iluminarea tastaturii în funcție de lumina ambientală"

msgid "Ambient light: %1 lux"
msgstr "Lumină ambientală: %1 lx"

msgid "Keyboard backlight: level %1 of %2"
msgstr "Iluminare: nivelul %1 din %2"

msgid "Paused after a manual change (%1 min left)"
msgstr "În pauză după o modificare manuală (mai sunt %1 min)"

msgid "Resume now"
msgstr "Reia acum"

msgid "Active"
msgstr "Activ"

msgid "Inactive"
msgstr "Inactiv"

msgid "Light sensor not available"
msgstr "Senzorul de lumină nu este disponibil"
