msgid "Paused after a manual change (%1 min left)"
msgstr "Em pausa após uma alteração manual (faltam %1 min)"

msgid "Resume now"
msgstr "Retomar agora"

msgid "Active"
msgstr "Ativo"

msgid "Inactive"
msgstr "Inativo"

msgid "Light sensor not available"
msgstr "Sensor de luz indisponível"
